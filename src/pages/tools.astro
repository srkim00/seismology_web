---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import TeachingToolPanel from "../components/TeachingToolPanel.astro";
import { TEACHING_TOOL_IDS, teachingTools } from "../data/teaching";
import { withBase } from "../lib/urls";
---

<BaseLayout
  title="Tools & Teaching"
  background="reading"
  description="Interactive geophysics material provided by the Seismology Laboratory at Korea University."
>
  <PageHeader title="Tools & Teaching" />

  <div class="container-page py-12">
    <div class="mb-8 flex flex-wrap gap-5 text-sm font-medium">
      <a href={withBase("/classes/")} class="text-primary-300 hover:text-primary-200 hover:underline">Classes &rarr;</a>
      <a href={withBase("/classes/geophysics/")} class="text-primary-300 hover:text-primary-200 hover:underline">Geophysics &rarr;</a>
    </div>
    <div class="space-y-6">
      {TEACHING_TOOL_IDS.map((id) => <TeachingToolPanel {...teachingTools[id]} />)}
    </div>
  </div>
</BaseLayout>
