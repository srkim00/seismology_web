---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PubList from "../components/PubList.astro";
import ResearchAreaIcon from "../components/ResearchAreaIcon.astro";
import { getResearchGroups } from "../lib/content";
import { withBase } from "../lib/urls";

// Data-driven: papers group by their `areas` tags. Each area shows its most
// recent few with a link to the full, area-filtered Publications list.
const groups = await getResearchGroups(4);
---

<BaseLayout
  title="Research"
  background="reading"
  description="An overview of the lab's research topics and methods."
>
  <PageHeader title="Research" />
  <div class="container-page space-y-16 py-12">
    {
      groups.map((group) => (
        <div class="space-y-10 sm:space-y-12">
            {group.areas.map((area, index) => (
              <section
                id={area.slug}
                aria-labelledby={`${area.slug}-heading`}
                data-research-theme={area.slug}
                data-floating-panel="true"
                data-floating-variant={String((index % 3) + 1)}
                class="research-area-panel layered-card glass-panel glass-panel-heavy scroll-mt-24 rounded-2xl border p-5 sm:p-8"
              >
                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                  <div class="flex items-center gap-3">
                    <span class="research-theme-icon flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border">
                      <ResearchAreaIcon area={area.slug} class="h-5 w-5" />
                    </span>
                    <h2 id={`${area.slug}-heading`} class="research-theme-heading font-serif text-2xl font-semibold">{area.label}</h2>
                  </div>
                  {area.total > area.pubs.length && (
                    <a
                      href={withBase(`/publications#${area.slug}`)}
                      class="research-theme-link group inline-flex min-h-10 shrink-0 items-center gap-1 text-sm font-medium transition-colors hover:underline"
                    >
                      All {area.total}
                      <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                        &rarr;
                      </span>
                    </a>
                  )}
                </div>
                <p class="mt-4 max-w-3xl leading-relaxed text-muted">{area.blurb}</p>
                {area.pubs.length > 0 ? (
                  <div class="research-area-publications mt-6 border-t">
                    <PubList pubs={area.pubs} layout="research" />
                  </div>
                ) : (
                  <p class="mt-4 text-sm text-muted">No publication has yet been assigned to this area.</p>
                )}
              </section>
            ))}
        </div>
      ))
    }
  </div>
</BaseLayout>
