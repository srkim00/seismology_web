---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PubList from "../components/PubList.astro";
import ResearchAreaIcon from "../components/ResearchAreaIcon.astro";
import { getResearchGroups } from "../lib/content";
import { withBase } from "../lib/urls";

// Data-driven: papers group by their `areas` tags. Each area shows its most
// recent few with a link to the full, area-filtered Publications list.
const groups = await getResearchGroups(4);
---

<BaseLayout
  title="Research"
  description="An overview of the lab's research topics and methods."
>
  <PageHeader title="Research" />
  <div class="container-page space-y-16 py-12">
    {
      groups.map((group) => (
        <section>
          <div class="mb-3 h-1 w-12 rounded-full bg-accent-500"></div>
          <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{group.title}</h2>
          <div class="mt-8 space-y-12">
            {group.areas.map((area) => (
              <div id={area.slug} class="scroll-mt-24">
                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                  <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary-800 bg-primary-950 text-primary-300">
                      <ResearchAreaIcon area={area.slug} class="h-5 w-5" />
                    </span>
                    <h3 class="font-serif text-2xl font-semibold text-ink">{area.label}</h3>
                  </div>
                  {area.total > area.pubs.length && (
                    <a
                      href={withBase(`/publications#${area.slug}`)}
                      class="group inline-flex shrink-0 items-center gap-1 text-sm font-medium text-primary-300 transition-colors hover:text-primary-200"
                    >
                      All {area.total}
                      <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                        &rarr;
                      </span>
                    </a>
                  )}
                </div>
                <p class="mt-2 max-w-3xl text-muted">{area.blurb}</p>
                {area.pubs.length > 0 ? (
                  <div class="mt-4">
                    <PubList pubs={area.pubs} />
                  </div>
                ) : (
                  <p class="mt-4 text-sm text-muted">No publication has yet been assigned to this area.</p>
                )}
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
