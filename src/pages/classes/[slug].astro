---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import TeachingToolPanel from "../../components/TeachingToolPanel.astro";
import { teachingTools } from "../../data/teaching";
import { withBase } from "../../lib/urls";

export async function getStaticPaths() {
  return (await getCollection("courses")).map((course) => ({ params: { slug: course.id }, props: { course } }));
}

const { course } = Astro.props;
const { Content } = await render(course);
const d = course.data;
const tools = d.tools.map((id) => teachingTools[id]);
---

<BaseLayout title={d.title} description={d.summary} background="reading">
  <header class="page-heading border-b border-line bg-gradient-to-b from-surface-muted to-canvas">
    <div class="container-page py-10 sm:py-14">
      <a href={withBase("/classes/")} class="text-sm font-medium text-primary-300 hover:text-primary-200 hover:underline">&larr; Classes</a>
      <p class="mt-7 text-xs font-semibold tracking-wide text-primary-300 uppercase">{d.code} · {d.level}</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink sm:text-5xl">{d.title}</h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-muted">{d.summary}</p>
    </div>
  </header>
  <div class="container-page py-12">
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <div class="course-prose prose-content min-w-0 leading-relaxed text-muted">
        <Content />
      </div>
      <aside class="space-y-5" aria-label="Course information">
        <section class="glass-panel rounded-xl border p-5">
          <h2 class="font-serif text-xl text-ink">Instructor</h2>
          <p class="mt-3 text-sm">
            {d.instructorSlug ? <a href={withBase(`/people/${d.instructorSlug}/`)} class="text-primary-300 hover:text-primary-200 hover:underline">{d.instructor}</a> : d.instructor}
          </p>
          <p class="mt-2 text-xs leading-relaxed text-muted">Department of Earth and Environmental Sciences<br />Korea University</p>
        </section>
        {tools.length > 0 && (
          <section class="glass-panel rounded-xl border p-5">
            <h2 class="font-serif text-xl text-ink">Interactive models</h2>
            <ul class="mt-3 space-y-3 text-sm leading-relaxed">
              {tools.map((tool) => <li><a href={`#${tool.id}`} class="text-primary-300 hover:text-primary-200 hover:underline">{tool.title}</a></li>)}
            </ul>
          </section>
        )}
      </aside>
    </div>

    {tools.length > 0 && (
      <section class="mt-14 border-t border-line pt-10" aria-labelledby="interactive-models-heading">
        <h2 id="interactive-models-heading" class="font-serif text-2xl text-ink">Interactive models</h2>
        <div class="mt-6 space-y-6">
          {tools.map((tool) => <TeachingToolPanel {...tool} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .course-prose :global(h2) { margin-top: 2rem; margin-bottom: 0.8rem; font-size: 1.6rem; line-height: 1.3; }
  .course-prose :global(h2:first-child) { margin-top: 0; }
  .course-prose :global(p) { margin-top: 0.8rem; }
  .course-prose :global(ul), .course-prose :global(ol) { margin-top: 0.8rem; padding-left: 1.3rem; }
  .course-prose :global(ul) { list-style: disc; }
  .course-prose :global(ol) { list-style: decimal; }
  .course-prose :global(li + li) { margin-top: 0.65rem; }
  .course-prose :global(strong) { color: var(--color-ink); font-weight: 600; }
</style>
