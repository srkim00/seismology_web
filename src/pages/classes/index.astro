---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { withBase } from "../../lib/urls";

const courses = (await getCollection("courses")).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Classes" description="Courses and interactive geophysics teaching materials from the Seismology Laboratory at Korea University." background="reading">
  <PageHeader title="Classes" />
  <div class="container-page py-12">
    <div class="grid gap-6 md:grid-cols-2" aria-label="Course list">
      {courses.map((course) => (
        <article data-course-card={course.id} data-floating-panel="true" class="glass-panel rounded-2xl border p-6 sm:p-8">
          <p class="text-xs font-semibold tracking-wide text-primary-300 uppercase">{course.data.code} · {course.data.level}</p>
          <h2 class="mt-3 font-serif text-3xl text-ink">
            <a href={withBase(`/classes/${course.id}/`)} class="hover:text-primary-300 hover:underline">{course.data.title}</a>
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-muted">{course.data.summary}</p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Course topics">
            {course.data.topics.map((topic) => <li class="rounded-full border border-line bg-surface/60 px-2.5 py-1 text-xs text-muted">{topic}</li>)}
          </ul>
          <div class="mt-7 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5">
            <span class="text-sm text-muted">{course.data.instructor}</span>
            <a href={withBase(`/classes/${course.id}/`)} class="text-sm font-semibold text-primary-300 hover:text-primary-200 hover:underline">Course page &rarr;</a>
          </div>
        </article>
      ))}
    </div>
    <div class="mt-10 border-t border-line pt-6">
      <a href={withBase("/tools/")} class="text-sm font-medium text-primary-300 hover:text-primary-200 hover:underline">Browse interactive tools &rarr;</a>
    </div>
  </div>
</BaseLayout>
