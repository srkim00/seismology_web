---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapQuery)}`;
const socials = [
  { label: "Google Scholar", href: site.social.scholar },
  { label: "ResearchGate", href: site.social.researchgate },
  { label: "X / Twitter", href: site.social.twitter },
  { label: "GitHub", href: site.social.github },
].filter((s): s is { label: string; href: string } => Boolean(s.href));
---

<BaseLayout
  title="Contact"
  description={`Contact ${site.name} at ${site.institution}.`}
>
  <PageHeader title="Contact" />
  <div class="container-page py-12">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-stretch">
      <div data-floating-panel="true" data-floating-variant="2" class="layered-card glass-panel rounded-xl border p-6">
        <h2 class="font-serif text-xl text-ink">{site.shortName}</h2>
        <address class="mt-3 text-muted not-italic">
          {site.address.map((line) => (
            <p>
              {line === site.institution ? (
                <a href={site.institutionUrl} target="_blank" rel="noopener noreferrer" class="text-primary-300 hover:text-primary-200 hover:underline">
                  {line}
                </a>
              ) : line === site.university ? (
                <a href={site.universityUrl} target="_blank" rel="noopener noreferrer" class="text-primary-300 hover:text-primary-200 hover:underline">
                  {line}
                </a>
              ) : line}
            </p>
          ))}
        </address>

        <dl class="mt-6 space-y-2 text-sm">
          <div class="flex gap-2">
            <dt class="font-medium text-muted">Email</dt>
            <dd class="text-muted">{site.email}</dd>
          </div>
          {site.phone && (
            <div class="flex gap-2">
              <dt class="font-medium text-muted">Phone</dt>
              <dd>
                <a
                  href={`tel:${site.phone.replace(/[^0-9+]/g, "")}`}
                  class="text-primary-300 hover:text-primary-200 hover:underline">{site.phone}</a
                >
              </dd>
            </div>
          )}
        </dl>

        <h3 class="mt-8 text-sm font-semibold tracking-wide text-muted uppercase">
          Elsewhere
        </h3>
        <ul class="mt-2 space-y-1 text-sm">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary-300 hover:text-primary-200 hover:underline"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <div class="grow overflow-hidden rounded-xl border border-line shadow-lg shadow-black/20">
          <iframe
            title={`Map to ${site.shortName}`}
            src={mapSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-80 w-full lg:h-full"></iframe>
        </div>
        <a
          href={mapLink}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1 self-start text-sm font-medium text-primary-300 transition-colors hover:text-primary-200"
        >
          Open in Google Maps
          <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
