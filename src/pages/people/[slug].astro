---
import { getCollection, render } from "astro:content";
import ProfileLayout from "../../components/ProfileLayout.astro";
import PubList from "../../components/PubList.astro";
import { getPublications, publicationsForPerson } from "../../lib/content";

export async function getStaticPaths() {
  const people = await getCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);
const hasBio = (person.body ?? "").trim().length > 0;

const pubs = await getPublications();
const people = await getCollection("people");
const mine = publicationsForPerson(person, pubs, people)
  .filter((publication) => publication.data.status === "published")
  .slice(0, 15);
---

<ProfileLayout person={person}>
  {
    hasBio && (
      <div class="prose-content space-y-4 leading-relaxed text-muted">
        <Content />
      </div>
    )
  }

  {
    mine.length > 0 && (
      <section class:list={[hasBio && "mt-10"]}>
        <h2 class="mb-1 font-serif text-xl text-ink">
          Selected publications
        </h2>
        <PubList pubs={mine} />
      </section>
    )
  }
</ProfileLayout>
