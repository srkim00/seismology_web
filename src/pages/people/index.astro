---
import BaseLayout from "../../components/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PersonGroup from "../../components/PersonGroup.astro";
import { getGroupedPeople } from "../../lib/content";

const groups = await getGroupedPeople();
---

<BaseLayout
  title="People"
  description="Current members, alumni, and former researchers of the lab."
>
  <PageHeader title="People" />
  <div class="container-page py-12">
    {groups.map((g) => <PersonGroup title={g.group} people={g.people} />)}
  </div>
</BaseLayout>
