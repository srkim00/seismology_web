---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import CitationButton from "../../components/CitationButton.astro";
import ResearchAreaIcon from "../../components/ResearchAreaIcon.astro";
import {
  AREA_LABELS,
  briefFinding,
  findPersonForAuthor,
  formatPublicationDate,
  getPublicationNumberMap,
  getPublications,
} from "../../lib/content";
import { withBase } from "../../lib/urls";

export async function getStaticPaths() {
  const publications = await getCollection("publications");
  return publications.map((publication) => ({
    params: { slug: publication.id },
    props: { publication },
  }));
}

const { publication } = Astro.props;
const d = publication.data;
const publicationNumber = getPublicationNumberMap(await getPublications()).get(publication.id);
const people = await getCollection("people");
const articleUrl = d.sourceUrl ?? (d.doi ? `https://doi.org/${d.doi}` : d.url);
const showBrief = (d.summaryStatus === "source-checked" || d.summaryStatus === "approved") && Boolean(d.mainFindings);
const brief = showBrief ? briefFinding(d.mainFindings) : "";
const pageDescription = brief || d.fullCitation || d.title;
const localFigureRights = d.figure?.reuse === "local" ? d.figure : null;
const figureLabel = d.figure?.number && (/^Figure \d+$/i.test(d.figure.number) || /^Graphical abstract$/i.test(d.figure.number))
  ? d.figure.number
  : "representative figure";
---

<BaseLayout title={d.title} description={pageDescription} background="reading">
  <article data-publication-number={publicationNumber}>
    <header class="page-heading border-b border-line bg-gradient-to-b from-surface-muted to-canvas">
      <div class="container-page py-10 sm:py-14">
        <a href={withBase("/publications")} class="text-sm font-medium text-primary-300 hover:text-primary-200 hover:underline">
          &larr; All publications
        </a>
        <p class="mt-7 text-sm font-semibold tracking-wide text-muted uppercase">
          {publicationNumber && <>No. {publicationNumber} · </>}
          {d.status === "published" && d.publicationDate ? (
            <>
              {d.journal ?? "Research output"} · <time datetime={d.publicationDate}>{formatPublicationDate(d.publicationDate)}</time>
            </>
          ) : (
            <>
              In preparation · <time datetime={String(d.year)}>{d.year}</time>
            </>
          )}
        </p>
        <h1 class="mt-3 max-w-5xl font-serif text-3xl leading-tight font-semibold text-ink sm:text-4xl">
          {d.title}
        </h1>
        <p class="mt-5 max-w-5xl text-sm leading-relaxed text-muted">
          {d.authors.map((author, index) => {
            const person = findPersonForAuthor(author, people);
            return (
              <>
                {index > 0 && ", "}
                {person ? (
                  <a href={withBase(`/people/${person.id}`)} class="font-medium text-primary-300 hover:text-primary-200 hover:underline">{author}</a>
                ) : author}
              </>
            );
          })}
        </p>
        <div class="mt-5 flex flex-wrap gap-2 text-xs">
          {d.doi && (
            <a href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener noreferrer" class="rounded-full bg-primary-600 px-3 py-1.5 font-medium text-white hover:bg-primary-500">
              DOI {d.doi}
            </a>
          )}
          {articleUrl && (
            <a href={articleUrl} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line bg-surface px-3 py-1.5 font-medium text-ink hover:border-primary-600">
              Publisher page
            </a>
          )}
          <CitationButton publication={publication} variant="pill" />
          {d.piCorresponding && (
            <span class="rounded-full border border-primary-800 bg-primary-950 px-3 py-1.5 font-medium text-primary-200">
              PI corresponding author
            </span>
          )}
          {d.areas.map((area) => (
            <a
              href={withBase(`/publications#${area}`)}
              class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1.5 text-muted hover:border-primary-700 hover:bg-elevated hover:text-primary-300"
              data-research-area-link={area}
            >
              <ResearchAreaIcon area={area} class="h-4 w-4" />
              {AREA_LABELS[area]}
            </a>
          ))}
        </div>
      </div>
    </header>

    <div class="container-page max-w-5xl py-12">
      {d.figure && (
        <section aria-labelledby="representative-figure">
          <h2 id="representative-figure" class="font-serif text-2xl text-ink">Representative figure</h2>
          <figure data-floating-panel="true" data-floating-variant="2" class="glass-panel glass-panel-heavy mt-5 overflow-hidden rounded-xl border">
            {d.figure.reuse === "local" && d.figure.image ? (
              <a href={d.figure.sourceUrl} target="_blank" rel="noopener noreferrer" class="figure-glass-stage figure-action m-3 flex sm:m-4">
                <span class="figure-paper min-h-48 sm:min-h-64">
                  <img src={withBase(d.figure.image)} alt={d.figure.alt} class="scientific-figure-image max-h-[48rem]" loading="lazy" />
                </span>
              </a>
            ) : (
              <div class="flex min-h-64 flex-col items-center justify-center bg-surface-muted/60 px-6 py-12 text-center">
                <svg viewBox="0 0 24 24" class="h-10 w-10 text-muted" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-13Z" />
                  <path d="m5 16 4.5-4.5 3 3 2-2L19 17M15.5 8.5h.01" />
                </svg>
                <a
                  href={d.figure.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${figureLabel} for ${d.title} on the publisher site`}
                  class="mt-4 inline-flex rounded-md font-medium text-primary-300 hover:text-primary-200 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
                >
                  View {figureLabel} at publisher &rarr;
                </a>
              </div>
            )}
            <figcaption class="border-t border-line p-5 sm:p-6">
              {brief && <p class="max-w-3xl text-base leading-relaxed text-ink">{brief}</p>}
              {d.figure.reuse === "local" && (
                <p class="mt-3 text-xs leading-relaxed text-muted">
                  {d.figure.number && <span class="font-semibold text-ink">{d.figure.number} · </span>}
                  {d.figure.attribution}
                  <span> · </span>
                  {localFigureRights?.licenseUrl ? (
                    <a href={localFigureRights.licenseUrl} target="_blank" rel="noopener noreferrer" class="text-primary-300 hover:text-primary-200 hover:underline">{localFigureRights.license}</a>
                  ) : (
                    <span>{localFigureRights?.license}</span>
                  )}
                </p>
              )}
            </figcaption>
          </figure>
        </section>
      )}

      {d.fullCitation && (
        <section id="citation" class:list={["scroll-mt-24 border-t border-line pt-8", d.figure ? "mt-10" : ""]}>
          <h2 class="text-sm font-semibold tracking-wide text-muted uppercase">Citation</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">{d.fullCitation}</p>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
