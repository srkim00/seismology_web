---
import "@fontsource-variable/inter";
import "@fontsource-variable/newsreader";
import "../styles/global.css";
import SEO from "./SEO.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import CitationDialog from "./CitationDialog.astro";
import AstronomicalBackground from "./AstronomicalBackground.astro";
import BackgroundCredit from "./BackgroundCredit.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  background?: "home" | "reading";
}

const { title, description, image, background } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEO title={title} description={description} image={image} />
  </head>
  <body
    class:list={[
      "flex min-h-screen flex-col",
      {
        "planetary-page": Boolean(background),
        "planetary-home": background === "home",
        "planetary-reading": background === "reading",
      },
    ]}
  >
    {background && <AstronomicalBackground priority={background === "home" ? "high" : "low"} />}
    <a
      href="#main"
      class="sr-only rounded-md bg-primary-600 px-4 py-2 text-white focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer>
      {background && <BackgroundCredit />}
    </Footer>
    <CitationDialog />
  </body>
</html>
