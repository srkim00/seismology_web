---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<header class="page-heading border-b border-line bg-gradient-to-b from-surface-muted to-canvas">
  <div class="container-page py-10 sm:py-14">
    <div class="h-0.5 w-12 rounded-full bg-accent-500" />
    <h1 class="mt-4 text-4xl font-semibold text-ink sm:text-5xl">{title}</h1>
  </div>
</header>
