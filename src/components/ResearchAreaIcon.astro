---
import type { AreaSlug } from "../lib/content";

interface Props {
  area: AreaSlug;
  class?: string;
  label?: string;
}

const {
  area,
  class: className = "h-5 w-5",
  label,
} = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.65"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  focusable="false"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  data-research-area-icon={area}
>
  {
    area === "geodynamics-structure" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path
          d="M7.2 6.2 9.4 4.9l2.1.6 1.3 1.5 2.8-.6 1.9 1.2-1 1.4 1.7 1-0.8 1.5-2.2-.2-1.1 1.4 1.2 1.1-0.6 1.4-1.2.3-0.6 2.3-1.5 1.2-1.1-1.9-1.8-.6-0.2-1.6-1.9-.7-0.8-1.6 1.2-1.2-1.5-1.5 1-1.2-0.5-1.4Z"
          fill="currentColor"
          stroke="none"
        />
      </>
    )
  }

  {
    area === "seismological-methods" && (
      <>
        <path d="M3 12h2.8l1.7-4.5 3.2 9 3-11 3 9 1.5-2.5H21" />
        <path d="M4 19h16" />
        <circle cx="4" cy="19" r="1.1" fill="currentColor" stroke="none" />
        <circle cx="12" cy="19" r="1.1" fill="currentColor" stroke="none" />
        <circle cx="20" cy="19" r="1.1" fill="currentColor" stroke="none" />
      </>
    )
  }

  {
    area === "earthquake-properties" && (
      <>
        <path
          d="M12 3A9 9 0 0 1 21 12c-4.9 0-9-4.1-9-9Z"
          fill="currentColor"
          stroke="none"
        />
        <path
          d="M12 21A9 9 0 0 1 3 12c4.9 0 9 4.1 9 9Z"
          fill="currentColor"
          stroke="none"
        />
        <circle cx="12" cy="12" r="9" />
      </>
    )
  }

  {
    area === "earthquake-engineering" && (
      <>
        <path d="M6 17V5h12v12M9 8h2m2 0h2M9 11h2m2 0h2M9 14h2m2 0h2" />
        <path d="M3 19c1.5-1.5 3-1.5 4.5 0s3 1.5 4.5 0 3-1.5 4.5 0 3 1.5 4.5 0" />
      </>
    )
  }

  {
    area === "environmental-seismology" && (
      <>
        <path d="M12 3.5c-2.3 3.1-4.2 5.3-4.2 7.6a4.2 4.2 0 0 0 8.4 0c0-2.3-1.9-4.5-4.2-7.6Z" />
        <path d="M3 19h4l1.4-2.5 2.8 5 2.3-4L15 19h6" />
      </>
    )
  }
</svg>
