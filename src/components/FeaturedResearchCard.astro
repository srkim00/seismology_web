---
import { getCollection } from "astro:content";
import type { Publication } from "../lib/content";
import { AREA_LABELS, briefFinding, formatPublicationDate, publicationRoleFlags } from "../lib/content";
import { withBase } from "../lib/urls";
import PublicationBadges from "./PublicationBadges.astro";
import ResearchAreaIcon from "./ResearchAreaIcon.astro";
import CitationButton from "./CitationButton.astro";

interface Props {
  publication: Publication;
  publicationNumber?: number;
  index?: number;
  mediaPriority?: boolean;
}

const { publication, publicationNumber, index = 0, mediaPriority = false } = Astro.props;
const d = publication.data;
const publicationDate = d.publicationDate;
const brief = briefFinding(d.mainFindings);
const localFigure = d.figure?.reuse === "local" ? d.figure : null;
const linkedFigure = d.figure?.reuse === "linked-only" ? d.figure : null;
const linkedFigureLabel = linkedFigure?.number ?? "Representative figure";
const people = await getCollection("people");
const { menteeLed, collaboration } = publicationRoleFlags(publication, people);
---

<article
  class:list={[
    "layered-card glass-panel glass-panel-heavy overflow-hidden rounded-lg border",
    localFigure
      ? "lg:grid lg:grid-cols-[minmax(0,1.55fr)_minmax(18rem,0.8fr)]"
      : "lg:grid lg:grid-cols-[18rem_minmax(0,1fr)]",
  ]}
  data-featured-research
  data-featured-slug={publication.id}
  data-publication-number={publicationNumber}
  data-featured-index={index + 1}
  data-media-kind={localFigure ? "local" : "linked-only"}
  data-floating-panel="true"
  data-floating-variant={String((index % 3) + 1)}
>
  {
    localFigure && (
      <figure class="flex min-h-0 flex-col border-b border-line bg-surface-muted/35 lg:border-r lg:border-b-0">
        <a
          href={localFigure.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="figure-glass-stage figure-action m-3 flex h-[22rem] items-center justify-center sm:m-4 sm:h-[28rem] lg:h-[34rem]"
        >
          <span class="figure-paper">
            <img
              src={withBase(localFigure.image)}
              alt={localFigure.alt}
              class="scientific-figure-image"
              loading={mediaPriority ? "eager" : "lazy"}
              fetchpriority={mediaPriority ? "high" : "auto"}
              decoding="async"
            />
          </span>
        </a>
        <figcaption class="border-t border-line bg-surface/45 px-4 py-2.5 text-[11px] leading-relaxed text-muted">
          {localFigure.attribution}
          <span> · </span>
          {localFigure.licenseUrl ? (
            <a href={localFigure.licenseUrl} target="_blank" rel="noopener noreferrer" class="text-primary-300 hover:text-primary-200 hover:underline">
              {localFigure.license}
            </a>
          ) : (
            <span>{localFigure.license}</span>
          )}
        </figcaption>
      </figure>
    )
  }
  {
    linkedFigure && (
      <figure class="flex min-h-0 flex-col border-b border-line bg-surface-muted/60 lg:border-r lg:border-b-0">
        <div class="flex min-h-72 grow flex-col items-center justify-center px-6 py-10 text-center">
          <svg viewBox="0 0 24 24" class="h-10 w-10 text-muted" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-13Z" />
            <path d="m5 16 4.5-4.5 3 3 2-2L19 17M15.5 8.5h.01" />
          </svg>
          <a
            href={linkedFigure.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 font-medium text-primary-300 hover:text-primary-200 hover:underline"
          >
            View {linkedFigureLabel} at publisher &rarr;
          </a>
        </div>
        <figcaption class="border-t border-line bg-surface/45 px-4 py-2.5 text-[11px] leading-relaxed text-muted">
          {linkedFigure.attribution}
        </figcaption>
      </figure>
    )
  }

  <div class="flex min-w-0 grow flex-col p-6 lg:p-8">
    <p class="text-xs font-semibold tracking-wide text-muted uppercase">
      {publicationNumber && <>No. {publicationNumber} · </>}
      {d.journal}
      {publicationDate && <> · <time datetime={publicationDate}>{formatPublicationDate(publicationDate)}</time></>}
    </p>
    <h3 class="mt-2 font-serif text-xl leading-snug text-ink sm:text-2xl">
      <a href={withBase(`/publications/${publication.id}`)} class="hover:text-primary-300 hover:underline">
        {d.title}
      </a>
    </h3>
    {brief && <p class="mt-4 text-sm leading-relaxed text-muted">{brief}</p>}
    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs" aria-label="Publication attributes">
      <PublicationBadges
        publication={publication}
        menteeLed={menteeLed}
        collaboration={collaboration}
      />
    </div>

    <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-5">
      <ul class="flex flex-wrap gap-1.5" aria-label="Research areas">
        {d.areas.map((area) => (
          <li>
            <a
              href={withBase(`/publications#${area}`)}
              aria-label={AREA_LABELS[area]}
              title={AREA_LABELS[area]}
              data-research-theme={area}
              class="research-area-tag flex h-8 w-8 items-center justify-center rounded-md border transition-colors"
            >
              <ResearchAreaIcon area={area} class="h-4.5 w-4.5" />
            </a>
          </li>
        ))}
      </ul>
      <div class="ml-auto flex flex-wrap items-center justify-end gap-3 text-sm">
        <CitationButton publication={publication} />
        <a
          href={withBase(`/publications/${publication.id}`)}
          class="shrink-0 font-medium text-primary-300 hover:text-primary-200 hover:underline"
        >
          View publication &rarr;
        </a>
      </div>
    </div>
  </div>
</article>
