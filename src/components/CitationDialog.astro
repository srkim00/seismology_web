---
import { CITATION_STYLE_META } from "../lib/citations";
---

<dialog
  id="citation-dialog"
  class="citation-dialog"
  aria-labelledby="citation-dialog-heading"
  aria-describedby="citation-dialog-description"
>
  <div class="citation-dialog-shell">
    <header class="flex items-start justify-between gap-5 border-b border-line px-5 py-4 sm:px-6">
      <div class="min-w-0">
        <p class="text-xs font-semibold tracking-[0.12em] text-primary-300 uppercase">Reference formats</p>
        <h2 id="citation-dialog-heading" class="mt-1 font-serif text-2xl leading-tight text-ink">Copy citation</h2>
      </div>
      <form method="dialog">
        <button
          type="submit"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-primary-600 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
          aria-label="Close citation dialog"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>
      </form>
    </header>

    <div class="citation-dialog-body px-5 py-5 sm:px-6 sm:py-6">
      <p id="citation-dialog-description" class="text-sm leading-relaxed text-muted">
        Select a journal style, review the reference, and copy it without leaving this page.
      </p>
      <p class="mt-3 max-w-full truncate text-sm font-semibold text-ink" data-citation-title></p>
      <p class="mt-1 font-mono text-xs text-muted" data-citation-doi></p>

      <fieldset class="citation-style-fieldset mt-5">
        <legend class="text-xs font-semibold tracking-wide text-muted uppercase">Journal style</legend>
        <div class="citation-style-grid mt-2.5">
          {
            CITATION_STYLE_META.map((style, index) => (
              <label class="citation-style-option">
                <input
                  type="radio"
                  name="citation-style"
                  value={style.id}
                  checked={index === 0}
                  data-citation-style
                />
                <span>{style.shortLabel}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="citation-preview-section mt-5">
        <p class="text-xs font-semibold tracking-wide text-muted uppercase">Reference preview</p>
        <div
          class="citation-preview mt-2.5"
          data-citation-preview
          tabindex="0"
          role="document"
          aria-label="Formatted reference preview"
        ></div>
        <p class="mt-2 text-xs leading-relaxed text-muted" data-citation-style-note></p>
      </div>

      <textarea
        class="citation-copy-fallback"
        data-citation-plain
        readonly
        tabindex="-1"
        aria-hidden="true"
      ></textarea>
    </div>

    <footer class="citation-dialog-footer border-t border-line px-5 py-3.5 sm:px-6">
      <div class="flex min-w-0 flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
        <button
          type="button"
          class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-md bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-300 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
          data-citation-copy
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="8" y="8" width="11" height="11" rx="2" />
            <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
          </svg>
          Copy reference
        </button>
        <p class="min-h-5 min-w-0 text-sm font-medium text-primary-300" role="status" aria-live="polite" aria-atomic="true" data-citation-status></p>
      </div>

      <p class="mt-2 text-xs leading-relaxed text-muted">
        Rich text and plain text are included when supported. Verify the current target-journal instructions before submission.
      </p>
    </footer>
  </div>
</dialog>

<script>
  interface CitationFormatPayload {
    id: string;
    label: string;
    shortLabel: string;
    note: string;
    plain: string;
    html?: string;
  }

  interface CitationPayload {
    publicationId: string;
    title: string;
    doi: string;
    formats: CitationFormatPayload[];
  }

  const dialog = document.querySelector<HTMLDialogElement>("#citation-dialog");
  const title = dialog?.querySelector<HTMLElement>("[data-citation-title]");
  const doi = dialog?.querySelector<HTMLElement>("[data-citation-doi]");
  const preview = dialog?.querySelector<HTMLElement>("[data-citation-preview]");
  const note = dialog?.querySelector<HTMLElement>("[data-citation-style-note]");
  const dialogBody = dialog?.querySelector<HTMLElement>(".citation-dialog-body");
  const plain = dialog?.querySelector<HTMLTextAreaElement>("[data-citation-plain]");
  const copy = dialog?.querySelector<HTMLButtonElement>("[data-citation-copy]");
  const status = dialog?.querySelector<HTMLElement>("[data-citation-status]");
  const radios = Array.from(dialog?.querySelectorAll<HTMLInputElement>("[data-citation-style]") ?? []);

  let activePayload: CitationPayload | null = null;
  let activeFormat: CitationFormatPayload | null = null;
  let activeTrigger: HTMLElement | null = null;

  const renderFormat = (styleId: string) => {
    if (!activePayload || !preview || !plain || !note) return;
    const format = activePayload.formats.find((item) => item.id === styleId) ?? activePayload.formats[0];
    if (!format) return;
    activeFormat = format;
    plain.value = format.plain;
    note.textContent = format.note;
    preview.toggleAttribute("data-code", format.id === "bibtex");
    if (format.html) preview.innerHTML = format.html;
    else preview.textContent = format.plain;
    if (status) status.textContent = "";
  };

  const openDialog = (trigger: HTMLElement, payload: CitationPayload) => {
    if (!dialog || typeof dialog.showModal !== "function" || !payload.formats.length) return false;
    activeTrigger = trigger;
    activePayload = payload;
    if (title) title.textContent = payload.title;
    if (doi) doi.textContent = payload.doi ? `DOI ${payload.doi}` : "";
    const defaultStyle = radios.find((radio) => radio.checked) ?? radios[0];
    renderFormat(defaultStyle?.value ?? payload.formats[0].id);
    if (dialogBody) dialogBody.scrollTop = 0;
    if (!dialog.open) dialog.showModal();
    document.documentElement.dataset.citationDialog = "open";
    defaultStyle?.focus();
    return true;
  };

  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element | null)?.closest<HTMLElement>("[data-citation-trigger]");
    if (!trigger) return;
    try {
      const payload = JSON.parse(trigger.dataset.citationPayload ?? "") as CitationPayload;
      if (openDialog(trigger, payload)) event.preventDefault();
    } catch {
      // Keep the ordinary detail-page anchor as the no-JavaScript/error fallback.
    }
  });

  radios.forEach((radio) => {
    radio.addEventListener("change", () => {
      if (radio.checked) renderFormat(radio.value);
    });
  });

  const fallbackCopy = () => {
    if (!plain || !copy) return false;
    const legacyDocument = document as unknown as { execCommand?: (commandId: string) => boolean };
    if (typeof legacyDocument.execCommand !== "function") return false;
    plain.focus({ preventScroll: true });
    plain.select();
    let copied = false;
    try {
      copied = legacyDocument.execCommand("copy");
    } catch {
      copied = false;
    }
    copy.focus({ preventScroll: true });
    return copied;
  };

  copy?.addEventListener("click", async () => {
    if (!activeFormat || !plain || !status) return;
    let copied = false;
    if (activeFormat.html && "ClipboardItem" in window && navigator.clipboard?.write) try {
      const item = new ClipboardItem({
        "text/plain": new Blob([activeFormat.plain], { type: "text/plain" }),
        "text/html": new Blob([`<p>${activeFormat.html}</p>`], { type: "text/html" }),
      });
      await navigator.clipboard.write([item]);
      copied = true;
    } catch {
      // Some browsers expose ClipboardItem but reject text/html. Try plain text next.
    }
    if (!copied && navigator.clipboard?.writeText) try {
      await navigator.clipboard.writeText(activeFormat.plain);
      copied = true;
    } catch {
      // The final legacy fallback below remains available outside secure contexts.
    }
    if (!copied) copied = fallbackCopy();
    status.textContent = copied ? `${activeFormat.shortLabel} reference copied.` : "Copy failed. Select the reference text and copy it manually.";
  });

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog?.addEventListener("close", () => {
    delete document.documentElement.dataset.citationDialog;
    if (status) status.textContent = "";
    const trigger = activeTrigger;
    activePayload = null;
    activeFormat = null;
    activeTrigger = null;
    if (trigger?.isConnected) trigger.focus({ preventScroll: true });
  });
</script>
