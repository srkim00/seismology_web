---
import { site } from "../data/site";
import { withBase } from "../lib/urls";

const year = new Date().getFullYear();

const socialLinks = [
  { label: "Google Scholar", href: site.social.scholar },
  { label: "ResearchGate", href: site.social.researchgate },
  { label: "X / Twitter", href: site.social.twitter },
  { label: "GitHub", href: site.social.github },
].filter((l): l is { label: string; href: string } => Boolean(l.href));

const linkClass =
  "text-primary-300 hover:text-primary-200 transition-colors";
---

<footer class="mt-20 border-t border-line bg-surface-muted">
  <div
    class="container-page grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-3"
  >
    <div class="flex items-start gap-4">
      <a
        href={site.universityUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 focus-visible:rounded-sm"
      >
        <img
          src={withBase("/brand/korea-university-global-symbol-crimson-negative.gif")}
          alt="Korea University"
          width="592"
          height="592"
          class="block h-14 w-14 object-contain sm:h-16 sm:w-16"
        />
      </a>
      <div>
        <p class="font-serif text-lg text-ink">{site.name}</p>
        <p class="mt-2 text-sm text-muted">
          <a href={site.institutionUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
            {site.institution}
          </a>
          <span class="mx-1 text-accent-500" aria-hidden="true">·</span>
          <a href={site.universityUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
            {site.university}
          </a>
        </p>
        <p class="mt-1 text-sm text-muted">
          Principal Investigator: {site.pi}
        </p>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-semibold tracking-wide text-muted uppercase">
        Contact
      </h2>
      <ul class="mt-3 space-y-1 text-sm">
        <li><span class="text-muted">{site.email}</span></li>
        {site.phone && (
          <li>
            <a href={`tel:${site.phone.replace(/[^0-9+]/g, "")}`} class={linkClass}>
              {site.phone}
            </a>
          </li>
        )}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold tracking-wide text-muted uppercase">
        Elsewhere
      </h2>
      <ul class="mt-3 space-y-1 text-sm">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={linkClass}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-page py-4 text-xs text-muted">
      <p>© {year} {site.name}.</p>
    </div>
  </div>
</footer>
