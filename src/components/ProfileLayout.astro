---

<BaseLayout title={name} description={`${role} — ${name}`} background="reading">
  <header class="page-heading border-b border-line bg-gradient-to-b from-surface-muted to-canvas">
    <div class="container-page py-10">
      <a
        href={withBase("/people")}
        class="group inline-flex items-center gap-1 text-sm font-medium text-primary-300 transition-colors hover:text-primary-200"
      >
        <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">&larr;</span>
        All people
      </a>
      <div class="mt-6 grid gap-8 sm:grid-cols-[11rem_1fr] sm:items-center">
        <div class="mx-auto h-44 w-44 overflow-hidden rounded-full shadow-lg shadow-black/20 ring-1 ring-line sm:mx-0">
          {
            headshot ? (
              <Image
                src={headshot}
                alt={name}
                width={352}
                height={352}
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-primary-950 text-4xl font-semibold text-primary-300">
                {initials}
              </div>
            )
          }
        </div>

        <div>
          <h1 class="font-serif text-3xl text-ink sm:text-4xl">{name}</h1>
          <p class="mt-1 text-lg text-primary-300">{role}</p>
          {displayedAffiliation && <p class="mt-1 max-w-2xl text-sm font-medium text-ink">{displayedAffiliation}</p>}
          {title && <p class="mt-1 max-w-2xl text-muted">{title}</p>}
          {
            linkItems.length > 0 && (
              <ul class="mt-4 flex flex-wrap items-center gap-2">
                {linkItems.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target={l.href.startsWith("mailto:") || l.download ? undefined : "_blank"}
                      rel={l.href.startsWith("mailto:") || l.download ? undefined : "noopener noreferrer"}
                      download={l.download}
                      class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1.5 text-xs font-medium text-primary-300 transition-colors hover:border-primary-600 hover:bg-primary-950"
                      title={l.label}
                      aria-label={l.label}
                    >
                      <svg
                        viewBox="0 0 24 24"
                        class="h-4 w-4"
                        fill={ICONS[l.type].color ?? "currentColor"}
                        aria-hidden="true"
                      >
                        <path d={ICONS[l.type].d} />
                      </svg>
                      <span>{l.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </div>
  </header>

  <div class="container-page py-12">
    <div class="max-w-3xl">
      <slot />
    </div>
  </div>
</BaseLayout>
