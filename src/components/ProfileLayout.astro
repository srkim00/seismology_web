---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import type { Person } from "../lib/content";
import { withBase } from "../lib/urls";

interface Props {
  person: Person;
}
const { person } = Astro.props;
const {
  name,
  status,
  role,
  title,
  affiliation,
  currentAffiliation,
  headshot,
  links,
} = person.data;
const displayedAffiliation = status === "alumni"
  ? currentAffiliation ?? "Current affiliation not publicly verified"
  : affiliation;

const initials = name
  .split(",")[0]
  .split(/\s+/)
  .map((t) => t[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();

type LinkType =
  | "email"
  | "website"
  | "institutional"
  | "scholar"
  | "orcid"
  | "researchgate"
  | "github"
  | "twitter"
  | "linkedin"
  | "cv";
const linkItems = [
  links.email && { type: "email", label: links.email, href: `mailto:${links.email}` },
  links.cv && { type: "cv", label: "Download CV (PDF)", href: withBase(links.cv), download: "Seongryong-Kim-CV.pdf" },
  links.institutional && { type: "institutional", label: "Institutional profile", href: links.institutional },
  links.website && { type: "website", label: "Website", href: links.website },
  links.scholar && { type: "scholar", label: "Scholar profile", href: links.scholar },
  links.orcid && { type: "orcid", label: `ORCID ${links.orcid.split("/").pop()}`, href: links.orcid },
  links.researchgate && { type: "researchgate", label: "ResearchGate", href: links.researchgate },
  links.github && { type: "github", label: "GitHub", href: links.github },
  links.twitter && { type: "twitter", label: "X / Twitter", href: links.twitter },
  links.linkedin && { type: "linkedin", label: "LinkedIn", href: links.linkedin },
].filter(Boolean) as { type: LinkType; label: string; href: string; download?: string }[];

// Brand glyphs (single-path simple-icons silhouettes). ORCID/LinkedIn/Scholar/X
// carry their brand color; email/website inherit the link text color.
